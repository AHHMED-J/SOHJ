-    if (IOS_SupportedHIDDevice(ioHIDDeviceObject)) {
+    /* GameController.framework claims composite devices as a keyboard/mouse without exposing a GCController */
+    if (HasGamepadPrimaryUsage(ioHIDDeviceObject) && IOS_SupportedHIDDevice(ioHIDDeviceObject)) {
         return SDL_TRUE;
     }
 #endif
