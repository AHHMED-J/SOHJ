+static SDL_bool IsGamepadUsage(uint32_t usagePage, uint32_t usage)
+{
+    return usagePage == kHIDPage_GenericDesktop &&
+           (usage == kHIDUsage_GD_Joystick ||
+            usage == kHIDUsage_GD_GamePad ||
+            usage == kHIDUsage_GD_MultiAxisController);
+}
+
+/* Composite devices (e.g. GameSir G7 Pro over Bluetooth) report a consumer-control primary usage
+   but still contain a gamepad application collection. Find it in the device usage pairs. */
+static SDL_bool HasGamepadUsagePair(IOHIDDeviceRef hidDevice, uint32_t *usagePage, uint32_t *usage)
+{
+    CFArrayRef pairs = (CFArrayRef)IOHIDDeviceGetProperty(hidDevice, CFSTR(kIOHIDDeviceUsagePairsKey));
+    CFIndex i;
+
+    if (!pairs || CFGetTypeID(pairs) != CFArrayGetTypeID()) {
+        return SDL_FALSE;
+    }
+    for (i = 0; i < CFArrayGetCount(pairs); i++) {
+        CFDictionaryRef pair = (CFDictionaryRef)CFArrayGetValueAtIndex(pairs, i);
+        CFNumberRef pageRef, usageRef;
+        uint32_t pairPage = 0, pairUsage = 0;
+
+        if (!pair || CFGetTypeID(pair) != CFDictionaryGetTypeID()) {
+            continue;
+        }
+        pageRef = (CFNumberRef)CFDictionaryGetValue(pair, CFSTR(kIOHIDDeviceUsagePageKey));
+        usageRef = (CFNumberRef)CFDictionaryGetValue(pair, CFSTR(kIOHIDDeviceUsageKey));
+        if (!pageRef || !usageRef) {
+            continue;
+        }
+        CFNumberGetValue(pageRef, kCFNumberSInt32Type, &pairPage);
+        CFNumberGetValue(usageRef, kCFNumberSInt32Type, &pairUsage);
+        if (IsGamepadUsage(pairPage, pairUsage)) {
+            *usagePage = pairPage;
+            *usage = pairUsage;
+            return SDL_TRUE;
+        }
+    }
+    return SDL_FALSE;
+}
+
+static SDL_bool ElementInGamepadCollection(IOHIDElementRef element)
+{
+    while (element) {
+        if (IOHIDElementGetType(element) == kIOHIDElementTypeCollection &&
+            IOHIDElementGetCollectionType(element) == kIOHIDElementCollectionTypeApplication) {
+            return IsGamepadUsage(IOHIDElementGetUsagePage(element), IOHIDElementGetUsage(element));
+        }
+        element = IOHIDElementGetParent(element);
+    }
+    return SDL_FALSE;
+}
